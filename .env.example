# Copy to .env and fill in. Everything prefixed VITE_ is bundled into the
# browser build, so only public values belong here.

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key. Never put the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Server only (server/, never bundled: no VITE_ prefix) -------------------

# Supabase service-role (secret) key (Project Settings → API keys). The API
# server uses it to write the Clio sync and, until there is sign-in, to read
# matters. It bypasses RLS: never give it a VITE_ prefix or commit it. The
# server reuses VITE_SUPABASE_URL above for the project URL.
SUPABASE_SERVICE_ROLE_KEY=

# Port for the Express API server. Vite proxies /api to it in dev.
PORT=8787

# Where raw and intermediate data lives (git-ignored). The Clio token file
# is kept here as clio-tokens.json.
DATA_DIR=./data

# Clio developer app credentials (developers.clio.com → your app).
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Clio app. Clio only
# accepts https or http://127.0.0.1 (not localhost).
CLIO_REDIRECT_URI=http://127.0.0.1:5173/api/clio/callback
# Clio region: https://app.clio.com (US), https://eu.app.clio.com,
# https://ca.app.clio.com or https://au.app.clio.com.
CLIO_BASE_URL=https://app.clio.com

# OpenAI API key for summaries and extraction (platform.openai.com).
OPENAI_API_KEY=
# Model id; see docs/adr/0002-llm-model.md.
OPENAI_MODEL=gpt-5.4-mini
